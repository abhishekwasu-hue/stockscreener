# Copy to .env (never commit .env). All values are optional placeholders.

# --- Database (default: SQLite file data/amw.db) ---
# DATABASE_URL=postgresql+psycopg://amw:CHANGE_ME@localhost:5432/amw

# --- REST API ---
# AMW_AUTH_MODE=token            # token (default) | local (single-user desktop, no auth)
# AMW_CORS_ORIGINS=http://localhost:8501
# AMW_RATE_LIMIT_PER_MIN=120
# AMW_API_HOST=127.0.0.1
# AMW_API_PORT=8000
# AMW_API_WORKERS=1               # API processes (desktop default 1; docker-compose production default 4, Q-014).
#                                 # 4 measured 14x faster for DB-heavy reads; NOT a capacity guarantee (PERFORMANCE_RESULTS)
# AMW_API_THREADS=                # threads for synchronous endpoints (default 40); see PERFORMANCE_RESULTS.md P-002

# --- Strategy Lab ---
# AMW_ALLOW_UNSANDBOXED=0        # 1 = local trusted mode when no OS sandbox exists (Windows desktop, own code only)
# AMW_LAB_MAX_CONCURRENCY=2
# AMW_LAB_MAX_PER_USER=1
# AMW_LAB_MAX_JOBS_PER_USER=2
# AMW_LAB_LANGUAGES=python,pine,visual,sql,javascript,typescript,lua,r   # restrict released authoring modes

# --- AI (Bring Your Own Key) ---
# Master key that encrypts users' stored API keys (urlsafe-base64, 32 bytes). Generate once with:
#   python -c "from src.ai.crypto import generate_master_key as g; print(g())"
# Keep it in your secret manager; losing it makes stored user keys unreadable (users re-enter them).
# AMW_SECRET_KEY=
# (AI provider keys are NOT configured here: each user adds their OWN OpenAI/Anthropic key in the app - BYOK.)

# --- Optional alert channels ---
# AMW_TELEGRAM_BOT_TOKEN=        # OFFICIAL AMW bot (operator). Users link their own chat via '/start <code>';
#                                  users may instead add their own bot in the app (token stored encrypted).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# (each user sets their own alert email address in the app)
# AMW_SCHEDULER=0                 # 1 = run scheduled scans/reports in this process (api_server.py sets 1)

# --- FYERS live 1-minute feed (each user connects their OWN FYERS app in the app; no operator keys here) ---
# AMW_REPORTS_DIR=                # generated report files (default <app>/data/reports; Docker: the shared 'reports' volume)
# AMW_FEED_AUTORESUME=0           # 1 = on start-up, restart feeds users left running (api_server.py sets 1).
#                                 # Safe with several processes: a database lease allows one collector per user.

# --- Optional billing webhook (HMAC-SHA256 of the raw body in X-Signature) ---
# AMW_BILLING_WEBHOOK_SECRET=

# --- Testing only ---
# AMW_PROVIDER=fixture           # SIMULATED data provider (never use in production)
